<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Title>TestFramework.Mock</Title>
		<Authors>DeadMoon0</Authors>
		<Product>TestFramework</Product>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>Test;UnitTest;IntegrationTest;Framework;Fluent;Timeline;Mock;Mocking;TestDouble;Stub;DependencyInjection;InProcess</PackageTags>
		<PackageIcon>Icon.png</PackageIcon>
		<Description>Test the system under test in-process from inside a TestFramework timeline, with its own dependencies replaced by declared test doubles. Packs declare a double once; MockEnvironment hosts the application's real service composition with the doubles standing in; MockExt.Host calls into it, awaiting async calls; and what the doubles record becomes findable run artifacts, verified from the frozen run.</Description>
		<Version>0.2.0</Version>
		<PackageProjectUrl>https://github.com/DeadMoon0/TestFramework-Mock</PackageProjectUrl>
		<RepositoryUrl>https://github.com/DeadMoon0/TestFramework-Mock.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Copyright>Copyright (c) DeadMoon0 2026</Copyright>
		<PackageReleaseNotes>BREAKING - needs TestFramework.Core 0.7.0; MockDefinition&lt;T&gt; is MockPack&lt;T&gt;, run.MockResult&lt;T&gt;(label) is run.HostResult&lt;T&gt;(label), and Include refuses a pack whose service the composition never registers - use IncludeAdditional to add one. A pack is checked when it is included, and a double called after its run has finished still answers but is not recorded. New: out and ref parameters, set up with MockArg.Ref&lt;T&gt;.Any and written back with Assigns, and synchronous Host calls that take the step's CancellationToken.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<!-- This package's own suite, and nobody else. -->
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>TestFramework.Mock.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<!-- Committed template output: regenerate with `dotnet t4 <template>.tt` (local tool manifest). -->
		<None Update="Setup\MockCallSetup.Arities.tt" Generator="TextTemplatingFileGenerator" LastGenOutput="MockCallSetup.Arities.g.cs" />
		<Compile Update="Setup\MockCallSetup.Arities.g.cs" AutoGen="True" DesignTime="True" DependentUpon="MockCallSetup.Arities.tt" />
		<None Update="Steps\MockExt.Arities.tt" Generator="TextTemplatingFileGenerator" LastGenOutput="MockExt.Arities.g.cs" />
		<Compile Update="Steps\MockExt.Arities.g.cs" AutoGen="True" DesignTime="True" DependentUpon="MockExt.Arities.tt" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Castle.Core" Version="5.2.1" />
		<!-- The lowest version Mock needs, so the system under test's own DI version wins on every target. -->
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
		<PackageReference Include="TestFramework.Core" Version="0.7.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="$(PackageIconSourcePath)">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
