<#@ template language="C#" #>
<#@ import namespace="System.Linq" #>
<#@ output extension=".g.cs" #>
<#
    // The Host overloads per argument count: each argument is bound from a run variable and the
    // hosted service arrives behind the call's own arguments, the convention every body follows.
    // Each arity has three shapes — a synchronous result, an awaited Task<T>, an awaited Task — so a
    // call returning a task always binds to an overload that awaits it.
    // Regenerate with: dotnet t4 MockExt.Arities.tt
    const int MaxArity = 8;

    string Types(int n) => string.Join(", ", Enumerable.Range(1, n).Select(i => "T" + i));
    string Parameters(int n) => string.Join(",\n        ", Enumerable.Range(1, n).Select(i => $"VariableReference<T{i}> argument{i}"));
    string Resolved(int n) => string.Join(", ", Enumerable.Range(1, n).Select(i => $"argument{i}.GetValue(variables)!"));
    string Refs(int n) => string.Join(", ", Enumerable.Range(1, n).Select(i => "argument" + i));
#>
