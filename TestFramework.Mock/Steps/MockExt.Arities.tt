<#@ template language="C#" #>
<#@ import namespace="System.Linq" #>
<#@ output extension=".g.cs" #>
<#
    // Every Host overload, for every argument count from none to eight: each argument is bound from a
    // run variable and the hosted service arrives behind the call's own arguments. Six shapes per count,
    // so a call always binds to an overload that treats it correctly - a synchronous result, an awaited
    // Task<T>, an awaited Task, a synchronous void call, and the two awaited shapes again with the step's
    // cancellation token behind the service.
    // Regenerate with: dotnet t4 MockExt.Arities.tt
    const int MaxArity = 8;

    // "T1, T2, " - the leading type arguments, empty for a call without arguments.
    string TypesPrefix(int n) => string.Concat(Enumerable.Range(1, n).Select(i => "T" + i + ", "));
    string Parameters(int n) => string.Concat(Enumerable.Range(1, n).Select(i => $"VariableReference<T{i}> argument{i},\n        "));
    string ResolvedPrefix(int n) => string.Concat(Enumerable.Range(1, n).Select(i => $"argument{i}.GetValue(variables)!, "));
    string Refs(int n) => string.Join(", ", Enumerable.Range(1, n).Select(i => "argument" + i));
    string Summary(int n) => n == 0
        ? "calls it"
        : "calls it with arguments bound from run variables — a named variable is declared as the step's\n    /// input, so the IO contract carries the dependency —";
    string Variables(int n) => n == 0 ? "_" : "variables";
#>
//------------------------------------------------------------------------------
// <auto-generated>
//     Generated from MockExt.Arities.tt — edit the template, not this file,
//     then regenerate with: dotnet t4 MockExt.Arities.tt
// </auto-generated>
