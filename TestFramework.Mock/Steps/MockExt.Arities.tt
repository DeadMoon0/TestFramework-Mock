       string guards = string.Concat(Enumerable.Range(1, n).Select(i => $"        ArgumentNullException.ThrowIfNull(argument{i});\n")) + "        ArgumentNullException.ThrowIfNull(call);\n";
#>
    /// <summary>
    /// A trigger that resolves the service from the run's mock host and <#= Summary(n) #> in a
    /// scope of its own. A call that returns an awaitable binds to the awaiting overloads instead; an
    /// awaitable this overload would not await is refused where it is declared.
    /// </summary>
    public static MockHostCallTrigger<TService, TResult> Host<<#= TypesPrefix(n) #>TService, TResult>(
        <#= Parameters(n) #>Func<<#= TypesPrefix(n) #>TService, TResult> call)
        where TService : class
    {
<#= guards #>
        return new MockHostCallTrigger<TService, TResult>(
            (<#= Variables(n) #>, service, _) => Task.FromResult(call(<#= ResolvedPrefix(n) #>service)),
            [<#= Refs(n) #>]);
    }

    /// <summary>
    /// A trigger that calls the hosted service and awaits the task it returns; the step's result is what
